# Copy to scripts/cluster.env (gitignored) and adjust for your laptop → nd17 workflow.
#
# CLUSTER_HOST   SSH target for rsync (user@host, no path)
# KEY_FILE       Optional PEM path for ssh -i; leave empty for NetID password at prompt
# REMOTE_REPO    Remote clone root in your home (code + models + mlruns)
# REMOTE_DATA    Shared cluster data volume path — NOT under ~/home

CLUSTER_HOST=nd17@is-aiclinic.ischool.uw.edu
KEY_FILE=
REMOTE_REPO='~/IsoCourt'
REMOTE_DATA=/data/models/navneeth
